[Unit]
Description=Suivi du materiel (Flask via gunicorn)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/suivi-matos
Environment=INVENTAIRE_SECRET=CHANGEZ-CETTE-CLE
ExecStart=/home/pi/suivi-matos/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
